{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "private": true,
  "description": "A clone of tabnews.com.br",
  "author": "Isaac 'H3rmel' Reginato (isaach3rmel@gmail.com)",
  "license": "MIT",
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "pretest": "npm run services:up",
    "dev": "npm run services:up && npm run wait-for-postgres && npm run migrations:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand --verbose'",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js"
  },
  "dependencies": {
    "@types/async-retry": "1.4.9",
    "async-retry": "1.3.3",
    "dotenv": "16.4.4",
    "dotenv-expand": "11.0.6",
    "next": "^13.1.6",
    "node-pg-migrate": "6.2.2",
    "pg": "8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "24.1.0",
    "@types/pg": "8.11.2",
    "@types/react": "19.1.8",
    "concurrently": "8.2.2",
    "jest": "29.6.2",
    "prettier": "^3.6.2",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
